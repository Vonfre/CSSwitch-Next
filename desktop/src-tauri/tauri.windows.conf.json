{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "resources": {
      "../../.runtime/python": "runtime/python",
      "../../.runtime/node": "runtime/node"
    }
  }
}
