{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CSSwitch Next",
  "version": "0.8.7",
  "identifier": "com.csswitch.next",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "npm run prepare:assets",
    "beforeDevCommand": "npm run prepare:assets"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CSSwitch Next",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../proxy": "proxy",
      "../../scripts": "scripts",
      "../../LICENSE": "LICENSE",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../NOTICE": "NOTICE"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMjc0OTM2ODk4MjM3RDMKUldUVE40S0pOa2tubXI2Q1BUeDkvclRjQ3o1MXNtS3ZzbmUxNDA3emRhWnZVUUpqYUM0SVhRUFgK",
      "endpoints": [
        "https://github.com/Vonfre/CSSwitch-Next/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
